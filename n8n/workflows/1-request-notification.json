      "id": "9c44daef-569c-58cd-ab20-69173348e9ef",
      "name": "Reject 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const day = (d) =>\n  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });\n\n// Only what the message needs: first names, the tool and the dates. No emails in logs.\nconst e = $input.first().json.event;\nconst when = `${day(e.startDate)} to ${day(e.endDate)}`;\nconst to = e.recipient.firstName;\nconst lines = {\n  requested: `Hi ${to}, ${e.otherPartyFirstName} would like to borrow your ${e.toolName} (${when}).`,\n  approved: `Hi ${to}, good news: ${e.otherPartyFirstName} approved your request for the ${e.toolName} (${when}).`,\n  declined: `Hi ${to}, ${e.otherPartyFirstName} can't lend the ${e.toolName} for ${when} this time.`,\n  cancelled: `Hi ${to}, the request for the ${e.toolName} (${when}) was cancelled.`,\n  returned: `Hi ${to}, the ${e.toolName} is marked as returned. Thanks for being part of the loop!`,\n};\nconst text = lines[e.status] || `Hi ${to}, there is an update on the ${e.toolName}.`;\n// The logged mock notification: always written to the n8n log, and to Discord when configured.\nconsole.log(`[lendloop] notify ${to} (${e.status}): ${text}`);\nreturn [{ json: { text, eventId: e.eventId, loanId: e.loanId, status: e.status } }];\n"
      },
      "id": "ade066fb-62f8-57e1-96f2-0c03052076a0",
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
