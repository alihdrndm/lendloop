      },
      "id": "24c5d088-2c9b-5b8e-961b-c3776f44d57a",
      "name": "Convex webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "6f2b4a0e-1c3d-4e5f-9a7b-8c9d0e1f2a3b"
    },
    {
      "parameters": {
        "jsCode": "// Reject anything not signed by Convex with LENDLOOP_N8N_SECRET, or older than 5 minutes.\nconst crypto = require('crypto');\nconst item = $input.first().json;\nconst headers = item.headers || {};\nconst timestamp = headers['x-lendloop-timestamp'];\nconst signature = String(headers['x-lendloop-signature'] || '').toLowerCase();\nconst payload = item.body && item.body.payload;\nconst secret = $env.LENDLOOP_N8N_SECRET;\n\nlet reason = 'missing';\nif (secret && timestamp && signature && typeof payload === 'string') {\n  const age = Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp));\n  if (!Number.isFinite(age) || age > 300) {\n    reason = 'stale';\n  } else {\n    const expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${payload}`).digest('hex');\n    const ok =\n      expected.length === signature.length &&\n      crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signature));\n    reason = ok ? 'ok' : 'mismatch';\n  }\n}\nif (reason !== 'ok') console.warn(`[lendloop] rejected webhook: ${reason}`);\nreturn [{ json: { valid: reason === 'ok', reason, event: reason === 'ok' ? JSON.parse(payload) : null } }];\n"
      },
      "id": "e85f8e7a-c8f1-57bc-94db-26aa360e74eb",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "2ae1cb13-735c-5d7a-ae5c-8d9e79d5360a",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b903e39-1204-54ec-8a0a-3dac1ecf5498",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
