        }
      },
      "id": "09280806-ddb1-5bc3-9c09-4b7fddfe767a",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Same scheme as convex/lib/hmac.ts: hex(HMAC_SHA256(secret, `${timestamp}.${body}`)).\nconst crypto = require('crypto');\nconst sign = (body) => {\n  const timestamp = String(Math.floor(Date.now() / 1000));\n  const signature = crypto\n    .createHmac('sha256', $env.LENDLOOP_CONVEX_SECRET)\n    .update(`${timestamp}.${body}`)\n    .digest('hex');\n  return { timestamp, signature };\n};\n\nconst msg = $('Compose message').first().json;\nconst body = JSON.stringify({\n  loanId: msg.loanId,\n  kind: 'request_notification',\n  status: 'sent',\n  channel: $env.DISCORD_WEBHOOK_URL ? 'discord' : 'log',\n  idempotencyKey: msg.eventId, // req:<loanId>:<status>, the same on every retry\n  detail: `Told the ${msg.status === 'requested' ? 'lender' : 'borrower'} (${msg.status})`,\n});\nreturn [{ json: { body, ...sign(body) } }];\n"
      },
      "id": "93ca7f5a-1240-5a24-a982-560d22f6c702",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
