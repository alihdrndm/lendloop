# Copy to n8n/.env (gitignored). Generate secrets with: openssl rand -hex 32

# Convex -> n8n: must equal N8N_INBOUND_SECRET in the Convex environment.
LENDLOOP_N8N_SECRET=

# n8n -> Convex: must equal CONVEX_INBOUND_SECRET in the Convex environment.
LENDLOOP_CONVEX_SECRET=

# Convex HTTP actions URL as seen from inside the container.
# Local dev backend: http://host.docker.internal:3211 (cloud: https://<deployment>.convex.site)
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Optional: post notifications to a Discord channel. Leave empty to only log them.
DISCORD_WEBHOOK_URL=
