# Copy to .env.local. `npx convex dev` fills in the Convex lines for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# The Convex environment is set with `npx convex env set NAME value`, not in this file:
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL
#   ADMIN_EMAILS              comma-separated admin emails
#   N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-request
#   N8N_INBOUND_SECRET        signs Convex -> n8n (same as LENDLOOP_N8N_SECRET in n8n/.env)
#   CONVEX_INBOUND_SECRET     verifies n8n -> Convex (same as LENDLOOP_CONVEX_SECRET in n8n/.env)
